# Copy to .env and adjust. All optional.

# Which image: cpu (any machine), openvino (Intel iGPU / Arc), cuda (NVIDIA).
# For cuda also start with -f docker-compose.nvidia.yml; for openvino with
# -f docker-compose.intel.yml (and set RENDER_GID).
AI_WORKER_VARIANT=cpu

# Shared secret the NVR must send as X-API-Key. Blank = no auth.
# This endpoint decodes any image posted to it, so set this unless it's on a
# network you fully trust.
AI_WORKER_API_KEY=

# Default model when the NVR doesn't name one. Fetch it into this machine's
# model volume with: ../scripts/fetch-ai-models.sh <model> --volume lightnvr-ai-worker-models
# yolov8n / yolo11n = fastest; s/m = more accurate (comfortable on a GPU).
AI_WORKER_MODEL=yolov8n

# auto | cuda | openvino | rocm | cpu - which ONNX Runtime provider to prefer.
AI_WORKER_PROVIDER=auto

# Host port to publish. Must match the address you enter in LightNVR.
AI_WORKER_PORT=8811

# Pin a release instead of tracking latest.
# LIGHTNVR_VERSION=0.5.0

# Only when building the cuda variant from source:
# AI_WORKER_BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
